{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Build C project with debug info",
            "command": "gcc",
            "args": [
                "-g",
                "${workspaceFolder}/hello.c",
                "-o",
                "${workspaceFolder}/hello.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}